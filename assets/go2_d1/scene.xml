<mujoco model="go2_d1 scene">
  <include file="go2d1.xml"/>

  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <rgba haze="0.1 0.15 0.25 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.4 0.6 0.9" rgb2="0.05 0.05 0.15" width="512" height="3072"/>

    <texture name="grass_tex" type="2d" builtin="checker" mark="edge"
      rgb1="0.15 0.45 0.1" rgb2="0.1 0.35 0.08"
      markrgb="0.2 0.5 0.15" width="300" height="300"/>
    <material name="grass_mat" texture="grass_tex" texuniform="true" texrepeat="8 8" reflectance="0.1"/>

    <texture name="path_tex" type="2d" builtin="checker" mark="edge"
      rgb1="0.55 0.5 0.4" rgb2="0.45 0.4 0.3"
      markrgb="0.5 0.45 0.35" width="100" height="100"/>
    <material name="path_mat" texture="path_tex" texuniform="true" texrepeat="2 2" reflectance="0.15"/>

    <material name="wood" rgba="0.6 0.4 0.2 1"/>
    <material name="cone_orange" rgba="1.0 0.5 0.1 1"/>
    <material name="flag_red" rgba="0.9 0.15 0.1 1"/>
    <material name="pole_gray" rgba="0.5 0.5 0.55 1"/>
    <material name="barrel_blue" rgba="0.1 0.35 0.7 1"/>
    <material name="box_brown" rgba="0.55 0.35 0.2 1"/>
  </asset>

  <worldbody>
    <light pos="6 -5 3" dir="-0.5 -0.3 -1" directional="true" diffuse="0.8 0.8 0.8"/>

    <geom name="floor" size="0 0 0.05" type="plane" material="grass_mat" friction="1.5 0.5 0.5"/>

    <body name="path" pos="6 -5 0.001">
      <geom name="path_strip" type="box" size="6 0.5 0.005" material="path_mat" friction="1.0 0.4 0.4"/>
    </body>

    <body name="start_flag" pos="-0.5 -10.5 0.02">
      <geom name="flag_pole" type="cylinder" size="0.03 1.2" material="pole_gray"/>
      <geom name="flag_banner" type="box" pos="0.15 0 1.1" size="0.18 0.005 0.12" material="flag_red"/>
      <geom name="start_platform" type="box" pos="0 0 0.001" size="0.4 0.4 0.001" rgba="0.7 0.7 0.7 1"/>
    </body>

    <body name="target_marker" pos="12 0 0.005">
      <geom name="cross_h" type="box" pos="0 0 0" size="0.3 0.05 0.005" rgba="0.9 0.1 0.1 1"/>
      <geom name="cross_v" type="box" pos="0 0 0" size="0.05 0.3 0.005" rgba="0.9 0.1 0.1 1"/>
      <!-- <geom name="target_pole" type="cylinder" pos="0.3 0 0.3" size="0.03 0.3" rgba="0.9 0.15 0.1 1"/> -->
    </body>

    <body name="cone_1" pos="1.5 -9.2 0.02">
      <geom name="cone_1_geom" type="cylinder" size="0.08 0.25" material="cone_orange"/>
      <geom name="cone_1_top" type="cylinder" pos="0 0 0.2" size="0.04 0.1" rgba="1 1 1 1"/>
    </body>

    <body name="box_1" pos="4 -8.5 0.02">
      <geom name="box_1_geom" type="box" size="0.3 0.2 0.2" material="box_brown"/>
    </body>

    <body name="barrel_1" pos="7 -7 0.02">
      <geom name="barrel_1_geom" type="cylinder" size="0.2 0.4" material="barrel_blue"/>
    </body>

    <body name="cone_2" pos="10 -3 0.02">
      <geom name="cone_2_geom" type="cylinder" size="0.08 0.25" material="cone_orange"/>
      <geom name="cone_2_top" type="cylinder" pos="0 0 0.2" size="0.04 0.1" rgba="1 1 1 1"/>
    </body>

    <body name="barrier_1" pos="8.0 -2 0.02">
      <geom name="barrier_1_geom" type="box" size="0.5 0.15 0.25" rgba="0.7 0.65 0.6 1"/>
    </body>

    <body name="rock_1" pos="3 -6 0.02">
      <geom name="rock_1_geom" type="sphere" size="0.25" rgba="0.5 0.45 0.4 1"/>
    </body>

    <body name="target_sphere" pos="12 0 0.04">
      <freejoint/>
      <geom name="target_ball" type="sphere" size="0.025" rgba="1.0 0.85 0.1 1" mass="0.005"/>
    </body>

    <!-- ============================================================ -->
    <!-- 多场景预留 body（初始停放在地下 y=100，由 TaskSceneManager 重定位）-->
    <!-- body 必须带 freejoint 才能在运行时改 qpos；不活跃时统一停在 park 区 -->
    <!-- ============================================================ -->

    <!-- golf_ball 场景：5 个白色高尔夫球（仅 golf_ball 场景激活时定位） -->
    <body name="golf_ball_0" pos="100 100 -5"><freejoint/><geom name="golf_geom_0" type="sphere" size="0.018" rgba="0.98 0.98 0.98 1" mass="0.0015"/></body>
    <body name="golf_ball_1" pos="100 100 -5"><freejoint/><geom name="golf_geom_1" type="sphere" size="0.018" rgba="0.98 0.98 0.98 1" mass="0.0015"/></body>
    <body name="golf_ball_2" pos="100 100 -5"><freejoint/><geom name="golf_geom_2" type="sphere" size="0.018" rgba="0.98 0.98 0.98 1" mass="0.0015"/></body>
    <body name="golf_ball_3" pos="100 100 -5"><freejoint/><geom name="golf_geom_3" type="sphere" size="0.018" rgba="0.98 0.98 0.98 1" mass="0.0015"/></body>
    <body name="golf_ball_4" pos="100 100 -5"><freejoint/><geom name="golf_geom_4" type="sphere" size="0.018" rgba="0.98 0.98 0.98 1" mass="0.0015"/></body>

    <!-- material_drop 场景：红色物料方块（material_drop 场景定位到 home，被抓取→携带→投放） -->
    <body name="payload_box" pos="100 100 -5"><freejoint/><geom name="payload_geom" type="box" size="0.03 0.03 0.03" rgba="0.85 0.15 0.15 1" mass="0.01"/></body>

    <!-- rain_inspect 场景：3 个深蓝「积水」标记（静态贴地，仅巡检演示用） -->
    <body name="puddle_0" pos="12.0 0.0 0.012"><geom name="puddle_geom_0" type="cylinder" size="0.10 0.005" rgba="0.10 0.20 0.55 0.70"/></body>
    <body name="puddle_1" pos="12.3 -0.2 0.012"><geom name="puddle_geom_1" type="cylinder" size="0.08 0.005" rgba="0.10 0.20 0.55 0.70"/></body>
    <body name="puddle_2" pos="11.75 0.3 0.012"><geom name="puddle_geom_2" type="cylinder" size="0.09 0.005" rgba="0.10 0.20 0.55 0.70"/></body>
  </worldbody>

  <!-- ============================================================ -->
  <!-- 抓取约束：weld equality（L1 软约束）                          -->
  <!-- 把 target_sphere 绑定到 d1_link6（TCP 所在 body）。默认 inactive，-->
  <!-- 夹爪闭合时运行时激活；松开时停用，球自由下落。                -->
  <!-- ============================================================ -->
  <equality>
    <weld name="grasp_weld" body1="target_sphere" body2="d1_link6"
          anchor="-0.00562 0.0 0.0706" active="false"
          solref="0.005 1" solimp="0.99 0.999 0.001"/>
  </equality>
</mujoco>
